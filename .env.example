# Required on Linux and CI. On macOS only, if this is unset, teanga-bench falls
# back to the macOS keychain item "omp-openrouter". Never commit real keys.
OPENROUTER_API_KEY=

# Optional: only needed when running with --batch (50%-off direct provider Batch APIs).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
