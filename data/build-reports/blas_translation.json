  "filters": {
    "app": [
      "skip _blocked, non-empty qualityFlags, verificationStatus 'rejected', usageRestrictions containing 'do-not-display'",
      "skip empty/placeholder text, native == english, unbalanced brackets",
      "both sides must end in . ? or ! (optionally followed by a quote or bracket) and not on a single-letter initial, which removes truncated Hansard sentences and fragments",
      "English side has 3+ words, English/native word ratio 0.5-2.0, and both sides have the same number of sentence-final marks (drops glosses such as 'Was it this morning you came? Yes.')",
      "4-30 words for translation, 6-25 words for round_trip (whitespace split of the native text)",
      "one sentence per normalized native text and per normalized English text"
    ],
    "corpus": [
      "split == 'test' only, 6-40 source words, target/source word ratio 0.7-1.7",
      "both sides start with a letter; Irish and Welsh rows must start with a capital and end in . ? or !",
      "no side may end in a clause mark followed by a full stop (';.', '—.')",
      "no garbled PDF extraction (glued words, lower-to-upper case jumps, 25+ character tokens, space before punctuation)",
      "no all-caps acronyms (they differ by language), no trailing section numbers, no quoted material, no title-case heading runs, identical digit sets, equal sentence-mark counts, and for Irish no pre-1958 spelling or syntax (nách, fé, i gcóir, unaccented 'no', 'a bheas', dhin/dintar, 'do' + verbal noun, -adh lá)",
      "balanced brackets, no URLs or e-mail addresses",
      "drop rows whose source or target text repeats inside the test split or also occurs in the train or dev split (leakage guard)"
    ]
  },
  "selection_order": "Candidates are ranked: private+approved, public+approved, private+deferred, public+deferred (verificationStatus starting 'approved' = approved; 'evidence-deferred' = deferred). Each tier is filled before the next, spread round-robin over CEFR levels. Private = the app's own bank (sentence-bank, hand-authored-earclip, blas-course-attested); all others (tatoeba, wikipedia, senedd-hansard, common-voice-cy, gaelg-parallel-usage, kaikki, ofis-publik, ...) are public-source.",
